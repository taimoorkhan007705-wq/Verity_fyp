# Frontend Environment Variables

# Local Development (Default)
VITE_API_URL=/api
VITE_API_BASE=http://localhost:5173

# For ngrok remote access
# Uncomment and replace with your ngrok URL
# VITE_API_URL=https://your-ngrok-url.ngrok-free.dev/api
# VITE_API_BASE=https://your-ngrok-url.ngrok-free.dev

# Production
# VITE_API_URL=https://yourdomain.com/api
# VITE_API_BASE=https://yourdomain.com

# Features
# VITE_ENABLE_AI_DETECTION=true
# VITE_ENABLE_LEADERBOARD=true
